# ---------------------------------------------------------------------------
# Policy Q&A Assistant with Evidence — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Gemini (Google AI Studio) ---------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Retrieval ---------------------------------------------------------------
TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.0

# --- Chunking ----------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Vector store -------------------------------------------------------------
CHROMA_DB_PATH=data/vector_store
CHROMA_COLLECTION_NAME=policy_documents

# --- Embeddings ----------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Storage paths -------------------------------------------------------
POLICY_DOCS_PATH=data/policies
QUESTIONS_DB_PATH=data/questions.db

# --- Application -------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Policy document editing -------------------------------------------------
# Required for PUT /documents/{document_id}. Keep this secret outside source control.
POLICY_ADMIN_KEY=

# --- Confidence / evaluation -----------------------------------------------
MIN_CONFIDENCE_FOR_SUPPORT=0.35

CHUNK_SIZE: int = 500
CHUNK_OVERLAP: int = 100
